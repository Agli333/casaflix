{
  "name": "casaflix",
  "productName": "CasaFlix",
  "version": "1.0.0",
  "description": "Biblioteca de vídeo local con una interfaz sencilla tipo plataforma de streaming.",
  "main": "main.js",
  "private": true,
  "license": "MIT",
  "author": "CasaFlix",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test:media": "electron scripts/make-test-media.js",
    "test:e2e": "node scripts/e2e-check.mjs",
    "icon": "electron scripts/make-icon.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:dir": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^40.10.6",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.casaflix.app",
    "productName": "CasaFlix",
    "icon": "build/icon.png",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "links.json",
      "build/icon.png",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
